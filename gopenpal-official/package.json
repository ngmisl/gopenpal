{
  "name": "gopenpal",
  "version": "1.0.0",
  "description": "Multi-agent AI assistant for health, productivity & personal growth",
  "author": "GopenPal Team",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "tsx watch --env-file=.env ./src/server",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "build:server": "tsc",
    "preview": "vite preview",
    "start": "node dist/server/index.js",
    "volt": "volt",
    "type-check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check . --write"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0",
    "@voltagent/cli": "^0.1.20",
    "@voltagent/core": "^2.0.6",
    "@voltagent/libsql": "^2.0.2",
    "@voltagent/logger": "^2.0.2",
    "@voltagent/server-hono": "^2.0.2",
    "@libsql/client": "^0.14.0",
    "ai": "^6.0.0",
    "hono": "^4.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "lucide-react": "^0.468.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.8.2",
    "tsx": "^4.19.3",
    "vite": "^6.0.3",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "agent",
    "ai",
    "voltagent",
    "health",
    "productivity",
    "multi-agent"
  ]
}
