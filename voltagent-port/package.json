{
  "name": "gopenpal-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "bun run src/server/index.ts",
    "dev:all": "concurrently \"bun run dev\" \"bun run server\"",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@voltagent/core": "workspace:*",
    "@voltagent/server-hono": "workspace:*",
    "@voltagent/libsql": "workspace:*",
    "@voltagent/logger": "workspace:*",
    "@libsql/client": "^0.14.0",
    "ai": "^6.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.2",
    "hono": "^4.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "lucide-react": "^0.468.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2"
  }
