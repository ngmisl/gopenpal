# GopenPal Environment Configuration
# Copy this file to .env and fill in your values

# OpenRouter API Key (required for chat features)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-api-key-here

# Default AI Model (optional)
# See available models at: https://openrouter.ai/models
GOPENPAL_MODEL=anthropic/claude-3.5-sonnet

# Database Location (optional)
# Default: ~/.gopenpal/gopenpal.db
GOPENPAL_DB=~/.gopenpal/gopenpal.db

# Logging Level (optional)
# Options: error, warn, info, debug, trace
RUST_LOG=info
